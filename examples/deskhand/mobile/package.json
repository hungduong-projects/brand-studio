{
  "name": "deskhand-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "start": "npm run sync-brand && expo start",
    "ios": "npm run sync-brand && expo start --ios",
    "android": "npm run sync-brand && expo start --android",
    "web": "npm run sync-brand && expo start --web",
    "export:web": "npm run sync-brand && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "verify": "node verify.mjs",
    "store-shots": "node scripts/store-shots.mjs"
  },
  "private": true
}
