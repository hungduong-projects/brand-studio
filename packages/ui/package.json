{
  "name": "@brand-studio/ui",
  "version": "0.8.1",
  "description": "Brand-driven React components for apps, AI agents, effects and visual storytelling.",
  "type": "module",
  "license": "MIT",
  "author": "Hung Duong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungduong-projects/brand-studio.git",
    "directory": "packages/ui"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
